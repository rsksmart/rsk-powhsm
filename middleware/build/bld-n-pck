#!/bin/bash

if [[ -z "$1" ]]; then
    echo "No main script specified"
    exit 1
fi

if [[ -z "$QUIET" ]]; then
    echo "Building '$1'..."
fi

# Script directory
pushd $(dirname $0) > /dev/null
BUILD_ROOT=$(pwd)
popd > /dev/null

# Root directory
HSM_ROOT=$BUILD_ROOT/../../

if [[ -n "$NATIVE" ]]; then
    # Build on the host itself, using its python environment
    # (e.g., to obtain native macOS binaries)
    $BUILD_ROOT/bld $1 || exit $?
    $BUILD_ROOT/pck $1 || exit $?
else
    $HSM_ROOT/docker/mware/do-notty-nousb /hsm2/middleware/build "./bld $1" || exit $?
    $HSM_ROOT/docker/packer/do-notty-nousb /hsm2/middleware/build "./pck $1" || exit $?
fi

BIN_PATH=$(cd $HSM_ROOT/middleware/bin && pwd)

if [[ -z "$QUIET" ]]; then
    if command -v sha256sum > /dev/null; then
        sha256sum $BIN_PATH/$1.tgz
    else
        shasum -a 256 $BIN_PATH/$1.tgz
    fi
else
    printf "."
fi
